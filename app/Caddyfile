:8080 {
	handle /health {
		respond "ok" 200
	}
	# Strip the frontend namespace and forward to the existing LQ.AI API.
	# Deliberately not encoded: compression can buffer server-sent chat streams.
	handle_path /lq/* {
		reverse_proxy api:8000
	}
	# Swagger UI at /lq/docs requests the schema from the site root.
	handle /openapi.json {
		reverse_proxy api:8000
	}
	handle {
		encode zstd gzip
		root * /srv
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
		}
		# Product SPA. Remote images are blocked so model output rendered as Markdown
		# cannot exfiltrate conversation content through image URLs. Mantine injects styles.
		@app not path /learn/playgrounds/* /word-addin/* /lq-ai/word-addin/*
		header @app Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self'"
		# Standalone Learn documents use inline scripts and are framed by the Learn page.
		@learn path /learn/playgrounds/*
		header @learn Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
		# The Word add-in sign-in dialog loads Office.js inside the Office host; its policy
		# needs validation in a real host before it is restricted further.
		# History routes such as /login and /change-password load the SPA.
		try_files {path} /index.html
		file_server
	}
}
